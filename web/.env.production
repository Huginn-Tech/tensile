# Build-time settings for Mocha's site (tensile-mocha.huginn.tech). Each network has a build of its own, and a value
# given on the command line wins over this file: the mainnet build gives its own (deploy/README.md, "5. The site").

# The site's public API. A shared link's preview takes the site's address from it, so its image is Mocha's own.
NEXT_PUBLIC_API_URL=https://tensile-mocha.huginn.tech/api/v1

# The validator run by this observer's own operator, marked "runs Tensile" in
# the table and on its page so a reader never has to guess which row belongs
# to the people publishing the figures. Nothing filters or adjusts on it.
NEXT_PUBLIC_SELF_VALIDATOR=celestiavalcons1u3qp465tr7p4nljcy9khp4u2gqngng4yyy9knf

# The network's name after "Tensile" in the site's titles ("Tensile Mocha" in the browser tab and a shared link's
# preview), and its own preview image (public/og-mocha.png). The mainnet build gives it empty
# (NEXT_PUBLIC_NETWORK_LABEL=): plain "Tensile" and og.png.
NEXT_PUBLIC_NETWORK_LABEL=Mocha

# Every network's site, for the header's switch (the same in every build), and the other network's site, where a
# record this site has no record of is asked for once (deploy/README.md, 5). Mainnet's site has been
# tensile.huginn.tech since 2026-10-19; the mainnet build gives its own other site (Mocha) on the command line.
NEXT_PUBLIC_NETWORKS=mainnet=https://tensile.huginn.tech,mocha=https://tensile-mocha.huginn.tech
NEXT_PUBLIC_OTHER_SITE_URL=https://tensile.huginn.tech
NEXT_PUBLIC_OTHER_NETWORK_LABEL=Mainnet
