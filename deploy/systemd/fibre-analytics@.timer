[Unit]
Description=Fibre observer (%i): refresh the Analytics page's data file

[Timer]
# A run takes about a second; the first, which reads every settlement, about
# half a minute (deploy/analytics-data.mjs). A run missed while the
# host was down has nothing to catch up on: the next one reads everything new.
OnCalendar=*:07/15
RandomizedDelaySec=30s
Unit=fibre-analytics@%i.service

[Install]
WantedBy=timers.target
# one instance per network: systemctl enable --now fibre-analytics@mocha.timer
