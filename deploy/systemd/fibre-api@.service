[Unit]
Description=Fibre observer (%i): read-only JSON API
After=network-online.target
Wants=network-online.target

[Service]
User=fibre-observer
EnvironmentFile=/etc/fibre-observer/%i.env
ExecStart=/usr/local/bin/observer-api -data-dir ${DATA_DIR} -listen ${API_LISTEN} -vantage ${VANTAGE} \
  -vantage-location ${VANTAGE_LOCATION} -vantage-provider ${VANTAGE_PROVIDER} \
  -publishers /etc/fibre-observer/publishers-%i.yaml
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# only this instance's data directory, not the service user's whole home
ReadWritePaths=/var/lib/fibre-observer/%i
# The API is the one service the internet reaches (through the site), so it
# is given none of what the others keep beside it: not the alert and backup
# settings of the env file, and not the keys and credentials in
# /etc/fibre-observer (the backup's SSH key and rclone.conf, the export
# signing key, a keyring), which is an empty directory to it but for this
# instance's publishers file. It reads the signing key's public half from the
# exports directory.
UnsetEnvironment=ALERT_WEBHOOK TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID BACKUP_REMOTE TENSILE_EXPORT_SIGNING_KEY
TemporaryFileSystem=/etc/fibre-observer:ro
BindReadOnlyPaths=-/etc/fibre-observer/publishers-%i.yaml

[Install]
WantedBy=multi-user.target
# one instance per network: systemctl enable --now fibre-api@mocha
