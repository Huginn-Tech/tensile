[Unit]
Description=Fibre observer (%i): daily refresh of the hosting IP databases

[Timer]
# iptoasn rebuilds its file every hour, so a network announced since the
# last download is known within a day; DB-IP publishes its Lite files once
# a month, and hosting-db.sh downloads each release once (it takes last
# month's while this month's is not up yet). After the night's export
# (03:00), backup and archive (04:40) runs. Persistent: a refresh missed
# while the host was down is made at boot. /v1/health fails hosting_db
# once the IP-to-ASN file is 7 days old.
OnCalendar=*-*-* 06:10:00 UTC
RandomizedDelaySec=30min
Persistent=true
Unit=fibre-hosting-db@%i.service

[Install]
WantedBy=timers.target
# one instance per network: systemctl enable --now fibre-hosting-db@mocha.timer
