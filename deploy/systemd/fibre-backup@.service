[Unit]
Description=Fibre observer (%i): copy the raw record off the host
After=network-online.target

[Service]
Type=oneshot
User=fibre-observer
EnvironmentFile=/etc/fibre-observer/%i.env
# Every observer process runs as one account and can read a sibling's
# environment, so each is given only the settings it uses: the alert
# credentials are the health watcher's alone (alert-<network>.env).
UnsetEnvironment=ALERT_WEBHOOK TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID TENSILE_EXPORT_SIGNING_KEY
ExecStart=/usr/local/bin/fibre-backup %i
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/fibre-observer/%i
