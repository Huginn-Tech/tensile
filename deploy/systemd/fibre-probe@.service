[Unit]
Description=Fibre observer (%i): retrievability prober (sentinel-probe)
After=network-online.target
Wants=network-online.target

[Service]
User=fibre-observer
EnvironmentFile=/etc/fibre-observer/%i.env
# Every observer process runs as one account and can read a sibling's
# environment, so each is given only the settings it uses: the alert
# credentials are the health watcher's alone (alert-<network>.env).
UnsetEnvironment=ALERT_WEBHOOK TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID BACKUP_REMOTE TENSILE_EXPORT_SIGNING_KEY
# PROBE_ARGS (optional, in the env file): extra flags for the prober, for
# example -max-read-mbps 600 -link-mbps 900. Unbraced so an empty value adds
# no argument, and each flag is its own argument.
#
# No -policy: nothing is sampled any more, and the day secrets of the last
# draws (September 2026) were revealed by 2026-10-04. Without it the prober
# reveals nothing and holds no sampling key; with it, it would only read a
# key already there, never create one.
ExecStart=/usr/local/bin/sentinel-probe -rpc ${RPC} -data-dir ${DATA_DIR} -vantage ${VANTAGE} -end-read -end-read-since ${END_READ_SINCE} $PROBE_ARGS
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# only this instance's data directory, not the service user's whole home
ReadWritePaths=/var/lib/fibre-observer/%i
# On a host shared with a validator, memory running out takes an observer
# process before the node: nothing changes while there is memory.
OOMScoreAdjust=500
# This process dials hosts validators choose and parses their answers, and
# reads no file of /etc/fibre-observer (its settings come from the
# environment systemd read before this applies): the backup key and remote
# beside them are not its to see, as they are not the API's.
TemporaryFileSystem=/etc/fibre-observer:ro

[Install]
WantedBy=multi-user.target
# one instance per network: systemctl enable --now fibre-probe@mocha
